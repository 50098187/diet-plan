model namc_diet_optimisation

# ============================================================================
# HYBRID INTEGER GOAL PROGRAMMING MODEL (FORMULATION 4)
# Monthly Diet Optimisation Using NAMC Food Basket
#
# Based on: 50098187_S_de_Beer_M5.pdf
# Approach: Hybrid Integer Goal Programming with weighted deviation variables
# Budget: R2,619/month (50% of SA minimum wage R5,239/month)
# Food Source: NAMC food basket only
# ============================================================================

# SETS
set FOODS = getFoodIndices();

# PARAMETERS (Food Data)
const cost = getCosts(), forall f in FOODS;
const protein = getProteins(), forall f in FOODS;
const carbs = getCarbs(), forall f in FOODS;
const fat = getFats(), forall f in FOODS;
const energy_kj = getEnergyKJ(), forall f in FOODS;

# PARAMETERS (Nutritional Targets - Monthly)
const target_energy = getTargetEnergy();      # Monthly energy requirement (kJ)
const target_protein = getTargetProtein();    # Monthly protein target (g)
const target_carbs = getTargetCarbs();        # Monthly carbohydrate target (g)
const target_fat = getTargetFat();            # Monthly fat target (g)

# PARAMETERS (Constraints)
const budget_max = getBudgetMax();            # Maximum monthly budget: R2,619
const min_variety = getMinVariety();          # Minimum variety: 5 different foods
const max_servings = getMaxServings();        # Maximum servings per food: 5

# PARAMETERS (Weights for Goal Programming)
const weight_cost = getWeightCost();          # ωC (cost weight - heavily weighted)
const weight_protein = getWeightProtein();    # ωP (protein weight)
const weight_carbs = getWeightCarbs();        # ωK (carbohydrate weight)
const weight_fat = getWeightFat();            # ωA (fat weight)

# DECISION VARIABLES
# Primary: Integer quantities of food items (servings per month)
int 0<=v<=150, forall f in FOODS;             # νf ∈ Z+ (0-150 servings/month)

# Binary: Food selection indicator
bin used, forall f in FOODS;                   # 1 if food f is used, 0 otherwise

# Deviation Variables for Goal Programming
var 0<=d_cost_plus<=10000;                     # Positive deviation from budget (dC⁺)
var 0<=d_protein_plus<=10000;                  # Positive deviation from protein target (dP⁺)
var 0<=d_protein_minus<=10000;                 # Negative deviation from protein target (dP⁻)
var 0<=d_carbs_plus<=10000;                    # Positive deviation from carbs target (dK⁺)
var 0<=d_carbs_minus<=10000;                   # Negative deviation from carbs target (dK⁻)
var 0<=d_fat_plus<=10000;                      # Positive deviation from fat target (dA⁺)
var 0<=d_fat_minus<=10000;                     # Negative deviation from fat target (dA⁻)

# OBJECTIVE FUNCTION: Minimise weighted sum of deviations
# Cost is heavily weighted (ωC ≫ ωP, ωK, ωA)
min weight_cost * d_cost_plus +
    weight_protein * (d_protein_plus + d_protein_minus) +
    weight_carbs * (d_carbs_plus + d_carbs_minus) +
    weight_fat * (d_fat_plus + d_fat_minus);

# ============================================================================
# HARD CONSTRAINTS (MUST be satisfied)
# ============================================================================

# C1: ENERGY CONSTRAINT (Hard)
# Total monthly energy must meet or exceed target
constr sum_{f in FOODS}{energy_kj_{f} * v_{f}} >= target_energy;

# C2: BUDGET CONSTRAINT (Hard)
# Total cost must not exceed budget, with cost deviation tracking
constr sum_{f in FOODS}{cost_{f} * v_{f}} - d_cost_plus <= budget_max;

# C3: VARIETY CONSTRAINT (Hard)
# Minimum 5 different foods must be selected
constr sum_{f in FOODS}{used_{f}} >= min_variety;

# C4: MAXIMUM SERVINGS PER FOOD (Hard)
# Each food can have maximum 5 servings per month
constr v_{f} <= max_servings * used_{f}, forall f in FOODS;

# C5: MINIMUM SERVINGS IF USED (Hard)
# If a food is used, it must have at least 1 serving
constr v_{f} >= 1 * used_{f}, forall f in FOODS;

# ============================================================================
# SOFT CONSTRAINTS (Goal Programming with deviation variables)
# ============================================================================

# C6: PROTEIN GOAL
# Track deviations from protein target (both above and below)
constr sum_{f in FOODS}{protein_{f} * v_{f}} - d_protein_plus + d_protein_minus = target_protein;

# C7: CARBOHYDRATE GOAL
# Track deviations from carbohydrate target (both above and below)
constr sum_{f in FOODS}{carbs_{f} * v_{f}} - d_carbs_plus + d_carbs_minus = target_carbs;

# C8: FAT GOAL
# Track deviations from fat target (both above and below)
constr sum_{f in FOODS}{fat_{f} * v_{f}} - d_fat_plus + d_fat_minus = target_fat;

end

# ============================================================================
# PYTHON DATA LOADING AND PROCESSING
# ============================================================================

import elytica
import json
import sys

# Load data from JSON file
data_file = 'data.json'

try:
    with open(data_file, 'r') as f:
        data = json.load(f)
except Exception as e:
    print(f"ERROR loading data file '{data_file}': {e}")
    sys.exit(1)

# Extract data sections
foods_data = data['foods']
user_data = data['user']
metabolic_data = data['metabolic']
constraints = data['constraints']
weights = data['weights']

food_count = len(foods_data)

print("=== NAMC DIET OPTIMISATION MODEL ===")
print(f"Budget: R{constraints['budget_max']}/month")
print(f"Foods available: {food_count}")
print(f"Variety required: {constraints['min_variety']} different foods")
print(f"Max servings per food: {constraints['max_servings']}")
print()

# ============================================================================
# HLPL DATA LOADING FUNCTIONS
# ============================================================================

getFoodIndices = lambda: list(range(1, food_count + 1))

# Food data (per unit/serving)
getCosts = lambda: {i+1: foods_data[i]['cost'] for i in range(food_count)}
getProteins = lambda: {i+1: foods_data[i]['protein'] for i in range(food_count)}
getCarbs = lambda: {i+1: foods_data[i]['carbs'] for i in range(food_count)}
getFats = lambda: {i+1: foods_data[i]['fat'] for i in range(food_count)}
getEnergyKJ = lambda: {i+1: foods_data[i]['energy_kj'] for i in range(food_count)}

# Targets (monthly)
getTargetEnergy = lambda: constraints['target_energy']
getTargetProtein = lambda: constraints['target_protein']
getTargetCarbs = lambda: constraints['target_carbs']
getTargetFat = lambda: constraints['target_fat']

# Hard constraints
getBudgetMax = lambda: constraints['budget_max']
getMinVariety = lambda: constraints['min_variety']
getMaxServings = lambda: constraints['max_servings']

# Weights for goal programming
getWeightCost = lambda: weights['cost']
getWeightProtein = lambda: weights['protein']
getWeightCarbs = lambda: weights['carbs']
getWeightFat = lambda: weights['fat']

# ============================================================================
# OPTIMISATION EXECUTION
# ============================================================================

def main():
    print("=== USER PROFILE ===")
    print(f"Weight: {user_data['weight']}kg, Height: {user_data['height']}cm, Age: {user_data['age']}")
    print(f"Gender: {user_data['gender']}")
    print(f"Activity Factor: {user_data['activity_factor']}")
    print(f"Goal: {user_data['goal']}")
    print()

    print("=== METABOLIC CALCULATIONS ===")
    print(f"BMR: {round(metabolic_data['bmr'], 2)} kcal/day")
    print(f"TDEE: {round(metabolic_data['tdee'], 2)} kcal/day")
    print(f"Target Energy (Monthly): {round(constraints['target_energy'] / 4184, 2)} kcal")
    print()

    print("=== WEIGHTS (Goal Programming) ===")
    print(f"Cost Weight (ωC): {weights['cost']} [heavily weighted]")
    print(f"Protein Weight (ωP): {weights['protein']}")
    print(f"Carbs Weight (ωK): {weights['carbs']}")
    print(f"Fat Weight (ωA): {weights['fat']}")
    print()

    # Initialise model
    print("Initialising optimisation model...")
    try:
        elytica.init_model("namc_diet_optimisation")
        print("✓ Model initialised successfully")
    except Exception as e:
        print(f"✗ ERROR initialising model: {e}")
        return 1

    # Set solver parameters
    print("\nSetting solver parameters...")
    try:
        elytica.set_gap_limit("namc_diet_optimisation", 0.001)
        elytica.set_time_limit("namc_diet_optimisation", 120)
        print("✓ Solver parameters set")
    except Exception as e:
        print(f"✗ ERROR setting solver parameters: {e}")
        return 1

    # Solve optimisation problem
    print("\nSolving optimisation problem...")
    try:
        elytica.run_model("namc_diet_optimisation")
        print("✓ Model solved successfully")
    except Exception as e:
        print(f"✗ ERROR solving model: {e}")
        return 1

    # Get objective value (weighted sum of deviations)
    print("\nRetrieving optimal solution...")
    try:
        objective_value = elytica.get_best_primal_bound("namc_diet_optimisation")
        print(f"Objective Value (Weighted Deviations): {round(objective_value, 2)}")
    except Exception as e:
        print(f"✗ ERROR getting objective value: {e}")
        return 1

    # ========================================================================
    # EXTRACT SOLUTION
    # ========================================================================

    print("\n=== OPTIMAL MONTHLY DIET PLAN ===")

    selected_foods = []
    total_cost = 0
    total_protein = 0
    total_carbs = 0
    total_fat = 0
    total_energy_kj = 0

    # Extract decision variables
    for i in range(1, food_count + 1):
        var_name = f"v{i}"
        servings = elytica.get_variable_value("namc_diet_optimisation", var_name)

        if servings >= 0.01:  # Tolerance for rounding
            food_index = i - 1
            food = foods_data[food_index]

            servings_int = int(round(servings))
            food_cost = servings_int * food['cost']
            food_protein = servings_int * food['protein']
            food_carbs = servings_int * food['carbs']
            food_fat = servings_int * food['fat']
            food_energy = servings_int * food['energy_kj']

            selected_foods.append({
                'name': food['name'],
                'category': food.get('category', 'Uncategorised'),
                'servings': servings_int,
                'cost': round(food_cost, 2),
                'protein': round(food_protein, 2),
                'carbs': round(food_carbs, 2),
                'fat': round(food_fat, 2),
                'energy_kj': round(food_energy, 2)
            })

            total_cost += food_cost
            total_protein += food_protein
            total_carbs += food_carbs
            total_fat += food_fat
            total_energy_kj += food_energy

            print(f"{food['name']}: {servings_int} servings @ R{round(food_cost, 2)}")

    # Extract deviation variables
    d_cost_plus = elytica.get_variable_value("namc_diet_optimisation", "d_cost_plus")
    d_protein_plus = elytica.get_variable_value("namc_diet_optimisation", "d_protein_plus")
    d_protein_minus = elytica.get_variable_value("namc_diet_optimisation", "d_protein_minus")
    d_carbs_plus = elytica.get_variable_value("namc_diet_optimisation", "d_carbs_plus")
    d_carbs_minus = elytica.get_variable_value("namc_diet_optimisation", "d_carbs_minus")
    d_fat_plus = elytica.get_variable_value("namc_diet_optimisation", "d_fat_plus")
    d_fat_minus = elytica.get_variable_value("namc_diet_optimisation", "d_fat_minus")

    print("\n=== MONTHLY TOTALS ===")
    print(f"Total Cost: R{round(total_cost, 2)} / R{constraints['budget_max']} (Budget)")
    print(f"Total Energy: {round(total_energy_kj, 2)} kJ ({round(total_energy_kj / 4.184, 2)} kcal)")
    print(f"Total Protein: {round(total_protein, 2)}g (Target: {round(constraints['target_protein'], 2)}g)")
    print(f"Total Carbs: {round(total_carbs, 2)}g (Target: {round(constraints['target_carbs'], 2)}g)")
    print(f"Total Fat: {round(total_fat, 2)}g (Target: {round(constraints['target_fat'], 2)}g)")
    print(f"Variety: {len(selected_foods)} different foods")

    print("\n=== DEVIATIONS (Goal Programming) ===")
    print(f"Cost Deviation (dC⁺): R{round(d_cost_plus, 2)}")
    print(f"Protein Deviation (dP⁺): {round(d_protein_plus, 2)}g above target")
    print(f"Protein Deviation (dP⁻): {round(d_protein_minus, 2)}g below target")
    print(f"Carbs Deviation (dK⁺): {round(d_carbs_plus, 2)}g above target")
    print(f"Carbs Deviation (dK⁻): {round(d_carbs_minus, 2)}g below target")
    print(f"Fat Deviation (dA⁺): {round(d_fat_plus, 2)}g above target")
    print(f"Fat Deviation (dA⁻): {round(d_fat_minus, 2)}g below target")

    # Build results JSON
    results = {
        'objective_value': round(objective_value, 2),
        'total_cost': round(total_cost, 2),
        'budget_max': constraints['budget_max'],
        'selected_foods': selected_foods,
        'totals': {
            'energy_kj': round(total_energy_kj, 2),
            'energy_kcal': round(total_energy_kj / 4.184, 2),
            'protein': round(total_protein, 2),
            'carbs': round(total_carbs, 2),
            'fat': round(total_fat, 2)
        },
        'targets': {
            'energy_kj': constraints['target_energy'],
            'protein': constraints['target_protein'],
            'carbs': constraints['target_carbs'],
            'fat': constraints['target_fat']
        },
        'deviations': {
            'cost_plus': round(d_cost_plus, 2),
            'protein_plus': round(d_protein_plus, 2),
            'protein_minus': round(d_protein_minus, 2),
            'carbs_plus': round(d_carbs_plus, 2),
            'carbs_minus': round(d_carbs_minus, 2),
            'fat_plus': round(d_fat_plus, 2),
            'fat_minus': round(d_fat_minus, 2)
        },
        'variety_count': len(selected_foods),
        'metabolic': {
            'bmr': round(metabolic_data['bmr'], 2),
            'tdee': round(metabolic_data['tdee'], 2)
        },
        'user': user_data
    }

    # Write results
    results_json = json.dumps(results, indent=2)
    print("\n=== WRITING RESULTS ===")
    print(results_json)

    elytica.write_results(results_json)
    print("\n✓ Results written successfully")

    return 0

# Run main
if __name__ == "__main__":
    sys.exit(main())
